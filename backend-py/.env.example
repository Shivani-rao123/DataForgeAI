# Environment: "development" or "production"
# Development auto-includes localhost CORS origins.
ENV=development

# LLM Provider
GROQ_API_KEY=your_groq_api_key_here

# Web Search
TAVILY_API_KEY=your_tavily_api_key_here

# Job connectors
# Adzuna (optional) — broad job-search aggregator. Get free keys at https://developer.adzuna.com/
# Without these, the Adzuna connector is skipped and the pipeline falls back to
# Greenhouse/Lever (named companies) + web_search. Greenhouse & Lever need NO key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in   # 2-letter country code: in, gb, us, au, ...

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dataforge

# Redis (used for RQ job queue and pub/sub)
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins, defaults to http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000
