# Environment: "development" or "production"
# Development auto-includes localhost CORS origins.
ENV=development

# LLM Provider
GROQ_API_KEY=your_groq_api_key_here

# Web Search
TAVILY_API_KEY=your_tavily_api_key_here

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dataforge

# Redis (used for RQ job queue and pub/sub)
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins, defaults to http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000
